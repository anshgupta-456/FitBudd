# Frontend (Next.js). Copy to .env.local for local work; set in Vercel for production.
# Where the Flask API lives. Defaults to http://localhost:5001 when unset.
NEXT_PUBLIC_API_BASE=http://localhost:5001

# Backend (Flask). Set these on Render, or export them before running gunicorn yourself.
# SECRET_KEY=          # required in production: a long random string, at least 32 characters
# FRONTEND_URL=        # your deployed site, e.g. https://fitbudd.vercel.app (comma-separate several)
# DATABASE_URL=        # optional; defaults to SQLite in backend/instance/. Postgres needs psycopg installed.
# SEED_ON_START=true   # fill an empty database with sample gyms, classes, trainers and a demo account
# APP_TIMEZONE=Asia/Kolkata
